# LangGraph Agent Server (`langgraph dev`) — free key at https://smith.langchain.com/settings
LANGSMITH_API_KEY=

# FastAPI
ISOVANE_HOST=127.0.0.1
ISOVANE_PORT=8092
CORS_ALLOW_ORIGINS=http://127.0.0.1:5317,http://localhost:5317,http://127.0.0.1:5173,http://localhost:5173

# Architecture image vision (see config/models.yaml)
# MODEL_PROVIDER is primarily set in config/models.yaml; env overrides that file.
ISOVANE_MODEL_PROVIDER=ollama
ISOVANE_OLLAMA_BASE_URL=http://127.0.0.1:11434
ISOVANE_OLLAMA_ARC_DIAGRAM_MODEL=llama3.2-vision
